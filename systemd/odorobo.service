[Unit]
Description=Odorobo Service
Documentation=https://github.com/FyraStack/odorobo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

EnvironmentFile=/etc/odorobo/config.env
ExecStart=/usr/bin/odorobo


Restart=always
RestartSec=3s
RestartPreventExitStatus=0
KillMode=mixed
# longer than the agent's own shutdown time (SHUTDOWN_TIMEOUT plus the runtime grace in main.rs)
TimeoutStopSec=90s

[Install]
WantedBy=multi-user.target
